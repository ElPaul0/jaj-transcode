# Copier ce fichier vers `.env` (local) et/ou `/etc/jaj-transcode.env` (systemd),
# puis adapter les valeurs. Toutes les clés sont optionnelles (des défauts existent).

# Répertoire de travail scanné par défaut (modifiable aussi dans l'UI)
JAJ_WORK_DIR=/data/videos

# Chemins FFmpeg (build avec hevc_nvenc + filtres vidstab/hqdn3d recommandés)
JAJ_FFMPEG=/opt/ffmpeg-btbn/bin/ffmpeg
JAJ_FFPROBE=/opt/ffmpeg-btbn/bin/ffprobe
JAJ_LD_LIBRARY_PATH=/opt/ffmpeg-btbn/lib

# Écoute HTTP
JAJ_HOST=0.0.0.0
JAJ_PORT=8791

# Données runtime (session.json, jobs.json) — créé automatiquement
# JAJ_DATA_DIR=/opt/jaj-transcode/data

# Extensions scannées (liste séparée par des virgules)
# JAJ_EXTENSIONS=.mts,.m2ts,.mov,.avi,.mpg,.mpeg,.vob,.mod,.tod,.3gp

# Concurrence jobs (sélecteurs UI en haut)
# Plafond du sélecteur remux (défaut 8) — monter ici si besoin
# JAJ_MAX_REMUX_CAP=8
# Plafond NVENC : 0 = auto (détection GPU), sinon force le max du sélecteur
# JAJ_MAX_NVENC_CAP=0
# Valeurs initiales des sélecteurs (clampées aux plafonds)
# JAJ_DEFAULT_MAX_NVENC=2
# JAJ_DEFAULT_MAX_REMUX=2
